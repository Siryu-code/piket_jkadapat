# Salin file ini jadi .env lalu isi nilainya. JANGAN isi rahasia di file .env.example.

# Dari dashboard Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Teks acak minimal 32 karakter (cara membuatnya ada di panduan)
SESSION_SECRET=

# Titik pusat area kelas (derajat desimal)
CLASS_LAT=
CLASS_LNG=
# Radius area kelas dan batas akurasi GPS, dalam meter
CLASS_RADIUS_M=150
MAX_ACCURACY_M=150

# Nama bucket foto di Supabase Storage
STORAGE_BUCKET=piket-foto

# Jam buka dan tutup pengiriman (WIB, 0-23)
OPEN_HOUR=5
CLOSE_HOUR=17

# KHUSUS PENGEMBANGAN (netlify dev di komputer sendiri): waktu palsu format ISO,
# contoh 2026-11-09T08:00:00+07:00. Kosongkan untuk memakai waktu asli.
# JANGAN diisi di dashboard Netlify.
DEV_FAKE_NOW=